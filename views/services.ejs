<!-- GA4 Tracking Script for Services Page CTA Interactions -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-ga-event]").forEach((element) => {
      element.addEventListener("click", function () {
        const eventName = this.getAttribute("data-ga-event");
        const eventCategory = this.getAttribute("data-ga-category");
        const eventLabel = this.getAttribute("data-ga-label");

        if (typeof gtag === "function") {
          gtag("event", eventName, {
            event_category: eventCategory,
            event_label: eventLabel,
            page_location: window.location.href
          });
        }
      });
    });
  });
</script>

