<%- include('partials/header') %>

<!-- TESTIMONIALS / REVIEWS JSON-LD SCHEMA (Dynamic EJS Loop for Local SEO) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": "https://www.buildinghomeco.com/#organization",
  "name": "Building Home",
  "license": "CBC1267326",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "<%= reviews.length %>"
  },
  "review": [
    <% reviews.forEach(function(review, index) { %>
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "<%- review.name %>"
      },
      "datePublished": "<%- review.date %>",
      "reviewBody": "<%- review.quote.replace(/"/g, '\\"') %>",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      }
    }<%= index < reviews.length - 1 ? ',' : '' %>
    <% }); %>
  ]
}
</script>

<!-- TESTIMONIALS HERO SECTION -->
<section class="reviews-hero" aria-label="Florida Certified Licensed Contractor Reviews Context">
  <div class="container">
    <span class="badge" style="display: inline-block; margin-bottom: 1rem;">
      Florida Certified Licensed General Contractor •
      <a href="https://www.myfloridalicense.com/" target="_blank" rel="noopener nofollow"
        style="color: inherit; text-decoration: underline;">License #CBC1267326</a>
    </span>
    <h1>Client Reviews & Verified Construction Success | Tampa Bay FL</h1>
    <p>Explore real structural metrics, ground-up build achievements, and verified feedback directly from local property
      owners across Tampa, Brandon, and Wesley Chapel who partnered with Building Home.</p>
  </div>
</section>

<!-- REVIEWS GRID SECTION -->
<section class="reviews-grid-section section-spacing">
  <div class="container">
    <div class="reviews-grid">

      <% reviews.forEach(function(review, index) { %>
      <article class="review-card"
        <%= index === 0 ? 'style="border: 2px solid var(--brand-accent, #d4af37); background: #0f172a;"' : '' %>>

        <blockquote class="review-quote">
          "<%= review.quote %>"
        </blockquote>

        <div class="review-metadata">
          <h3 class="client-name"><%= review.name %></h3>
          <p class="client-loc">
            <%= review.location %> &bull; <time><%= review.date %></time>
          </p>

          <div class="tag-row">
            <span class="service-tag"><%= review.service %></span>
          </div>
        </div>

      </article>
      <% }); %>

    </div>
  </div>
</section>

<!-- CONVERSION CTA SECTION -->
<section class="reviews-cta">
  <div class="container">
    <h2>Ready to Initialize Your New Build?</h2>
    <p>Have blueprints, site layouts, or engineered plans ready? Connect directly with licensed general contractor
      Gisselle Amparo to submit your specs for a comprehensive construction review.</p>
    <a href="/contact#quote-section" class="btn-accent">Upload Your Build Plans &rarr;</a>
  </div>
</section>

<%- include('partials/footer') %>